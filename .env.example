# Copy to .env (gitignored) ONLY if you want to override the generated secrets.
#
# You normally do NOT need this file: scripts/setup.sh creates .env on first run
# with random values for the demo client secrets, and renders the Keycloak realm
# from them. `.env` is gitignored; no secret is ever committed.
#
# The three client secrets below are generated automatically if absent.
# DEMO_CLI_SECRET=...
# MANAGER_CLI_SECRET=...
# MCP_TOOLS_SECRET=...

# ---------------------------------------------------------------------------
# Optional: a hosted LLM provider. The key is consumed ONLY by the LLM gateway
# (app/gateway) — the agent never holds it. The default path (local Ollama)
# needs no key at all.
#
#   OpenAI     LLM_PROVIDER=openai-compatible  LLM_BASE_URL=https://api.openai.com/v1
#   Groq       LLM_PROVIDER=openai-compatible  LLM_BASE_URL=https://api.groq.com/openai/v1
#   Together   LLM_PROVIDER=openai-compatible  LLM_BASE_URL=https://api.together.xyz/v1
#   LiteLLM    LLM_PROVIDER=openai-compatible  LLM_BASE_URL=http://litellm:4000/v1
#
# Set LLM_PROVIDER/LLM_BASE_URL/LLM_MODEL in deploy/kind/manifests/apps/gateway.yaml
# and put the key here:
# LLM_API_KEY=sk-...
