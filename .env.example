# =============================================================================
# Copy to .env (gitignored) and fill in your own values:
#     cp .env.example .env
#
# NEVER commit .env. The pre-commit hook and CI both block it.
# This project uses SYNTHETIC data only — never put real customer, card, or
# personal data in this file or anywhere in the repo.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM (provider-agnostic). Default is local Ollama: no credentials at all.
# For a hosted provider, set LLM_PROVIDER=openai-compatible plus base URL/model.
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1
#   Groq       LLM_BASE_URL=https://api.groq.com/openai/v1
#   Together   LLM_BASE_URL=https://api.together.xyz/v1
#   LiteLLM    LLM_BASE_URL=http://litellm:4000/v1
#   Ollama /v1 LLM_BASE_URL=http://host.docker.internal:11434/v1
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...        # only if you use a hosted provider

# ---------------------------------------------------------------------------
# Identity / authorization (local, disposable demo values)
# ---------------------------------------------------------------------------
KC_ISSUER=http://keycloak:8080/realms/agent-platform
SPIFFE_SOCKET=unix:///run/spire/sockets/agent.sock

# ---------------------------------------------------------------------------
# App services (in-cluster defaults)
# ---------------------------------------------------------------------------
TOOL_SERVER_URL=http://tool-server.agent-platform.svc.cluster.local:8000
OPA_URL=http://opa.agent-platform.svc.cluster.local:8181

# ---------------------------------------------------------------------------
# Datastore for agent checkpoints / approvals (local dev)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://app:app@localhost:5432/agent_platform

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
