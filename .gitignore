# ---------------------------------------------------------------------------
# Secrets — NEVER commit. The committed template is .env.example.
#     cp .env.example .env
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*credentials*.json
*service-account*.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Node / web
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Signing (cosign)
# ---------------------------------------------------------------------------
# The local demo signing key. Production signs keyless in CI — no key exists.
.cosign/

# ---------------------------------------------------------------------------
# Local runtime state / data (synthetic fixtures only; keep out of git)
# ---------------------------------------------------------------------------
# Root-anchored on purpose. A bare `data/` also matched
# deploy/kind/manifests/data/ and silently kept the Postgres manifest out of the
# repository — setup.sh applies it, so a fresh clone could not come up.
/data/
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------------
# Deployment artifacts
# ---------------------------------------------------------------------------
*.tgz
*.tar.gz
.kube/
*.rendered.yaml

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/

# Local port-forward pid + bind address (start.sh/stop.sh)
.port-forward.pid
.port-forward.addr

# The browser edge's CA and certificate. Generated by setup.sh so the edge can be
# verified rather than trusted blindly (a browser can import ca.crt); never
# committed, and regenerated if absent.
/.edge/

# Local, machine-specific notes (never committed)
NOTES.md
