{
  "realm": "agent-platform",
  "enabled": true,
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "passwordPolicy": "length(8)",
  "roles": {
    "realm": [
      { "name": "support_rep" },
      { "name": "manager" },
      { "name": "privacy" },
      { "name": "platform_admin" },
      { "name": "read_only" },
      { "name": "billing" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.com",
      "requiredActions": [],
      "attributes": { "tenant": ["acme"] },
      "realmRoles": ["support_rep"],
      "credentials": [
        { "type": "password", "value": "alice123", "temporary": false }
      ]
    },
    {
      "username": "manager",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Morgan",
      "lastName": "Manager",
      "email": "manager@example.com",
      "requiredActions": [],
      "attributes": { "tenant": ["acme"] },
      "realmRoles": ["manager"],
      "credentials": [
        { "type": "password", "value": "manager123", "temporary": false }
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "email": "admin@example.com",
      "requiredActions": [],
      "attributes": { "tenant": ["acme"] },
      "realmRoles": ["platform_admin"],
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ]
    },
    {
      "username": "grace",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Grace",
      "lastName": "Other",
      "email": "grace@globex.example",
      "requiredActions": [],
      "attributes": { "tenant": ["globex"] },
      "realmRoles": ["support_rep"],
      "credentials": [
        { "type": "password", "value": "grace123", "temporary": false }
      ]
    },
    {
      "username": "dana",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dana",
      "lastName": "Reader",
      "email": "dana@example.com",
      "requiredActions": [],
      "attributes": { "tenant": ["acme"] },
      "realmRoles": ["read_only"],
      "credentials": [
        { "type": "password", "value": "dana1234", "temporary": false }
      ]
    },
    {
      "username": "bella",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bella",
      "lastName": "Billing",
      "email": "bella@example.com",
      "requiredActions": [],
      "attributes": { "tenant": ["acme"] },
      "realmRoles": ["billing"],
      "credentials": [
        { "type": "password", "value": "bella123", "temporary": false }
      ]
    },
    {
      "username": "service-account-platform-admin",
      "enabled": true,
      "serviceAccountClientId": "platform-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    }
  ],

    "components": {
      "org.keycloak.userprofile.UserProfileProvider": [
        {
          "providerId": "declarative-user-profile",
          "config": {
            "kc.user.profile.config": [
              "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant\",\"displayName\":\"Tenant\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
            ]
          }
        }
      ]
    },
  "clients": [
    {
      "clientId": "portal",
      "description": "The web app's client. Real users sign in here (server-side password grant); tokens carry aud=agent AND aud=mcp-tools so the same session can run tasks and approve. Roles gate what the UI offers, and the API enforces them.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PORTAL_SECRET}",
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "spiffe://acme.com/ns/agent-platform/sa/agent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-tools",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mcp-tools",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "platform-admin",
      "description": "Service account the API uses to call Keycloak's Admin API for enrollment and role management. Least privilege: manage-users + read roles only. Its service-account roles are declared below.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false
    },
    {
      "clientId": "demo-cli",
      "description": "Stands in for the support rep's app in the scripted demo. Its tokens are audienced for the AGENT so the agent may exchange them.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${DEMO_CLI_SECRET}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "spiffe://acme.com/ns/agent-platform/sa/agent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "manager-cli",
      "description": "Stands in for the approver's app in the scripted demo. Its tokens carry aud=mcp-tools so the API accepts them.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MANAGER_CLI_SECRET}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-tools",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mcp-tools",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "spiffe://acme.com/ns/agent-platform/sa/agent",
      "description": "THE AGENT. client_id == SPIFFE ID. Authenticates with a JWT-SVID (client-jwt) verified against SPIRE's JWKS; no client secret. standard.token.exchange.enabled lets it exchange tokens; its audience mapper puts mcp-tools in the result.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "use.jwks.url": "true",
        "jwks.url": "http://spire-oidc-discovery.agent-platform.svc.cluster.local:11080/keys",
        "token.endpoint.auth.signing.alg": "ES256",
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "aud-tools",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mcp-tools",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mcp-tools",
      "description": "Audience for the tool servers (and the API). Resource servers accept only tokens minted for it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MCP_TOOLS_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}
